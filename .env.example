# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Serverless & Cloud Runtime Configuration
PORT=3000
NODE_ENV="production"

# Telegram Bot configuration for @abisundar_bot notifications
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional secret to protect the /api/cron/check endpoint when triggered by Cloud Scheduler / GitHub Actions
# CRON_SECRET="your_custom_cron_secret_here"

# Optional custom directory path for persisting JSON tracker store (defaults to ./data or /tmp/cubelelo_data)
# DATA_DIR="/tmp/cubelelo_data"

# Optional public application URL (e.g. https://my-cube-tracker.run.app)
APP_URL=""
